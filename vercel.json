{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "jekyll",
  "installCommand": "BUNDLE_PATH=vendor/bundle bundle install",
  "buildCommand": "BUNDLE_PATH=vendor/bundle JEKYLL_ENV=production bundle exec jekyll build",
  "outputDirectory": "_site",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  }
}
